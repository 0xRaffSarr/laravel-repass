{
    "name": "xraffsarr/laravel-repass",
    "description": "A custom password reset for Laravel",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/0xRaffSarr/laravel-repass",
    "autoload": {
        "psr-4": {
            "Xraffsarr\\LaravelRePass\\": "src/"
        }
    },
    "authors": [
        {
            "role": "developer",
            "name": "Raffaele Sarracino",
            "email": "work@raffaelesarracino.it",
            "homepage": "https://raffaelesarracino.it"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Xraffsarr\\LaravelRePass\\RePassServiceProvider"
            ],
            "aliases": {
                "RePass": "Xraffsarr\\LaravelRePass\\Facade\\RePass"
            }
        }
    },
    "prefer-stable": true,
    "require-dev": {
        "laravel/passport": "^13.8",
        "orchestra/testbench": "^10.0|^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Xraffsarr\\LaravelRePass\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
